# SpatialLab environment variables
# Copy to .env.local for local development. Never commit .env.local.

# Server-side only. Create a key at https://platform.claude.com/
# Without a key, local development runs in mock mode (clearly labeled);
# production shows a configuration notice instead.
ANTHROPIC_API_KEY=

# Vision-capable Claude model. Defined here (and only here) so the model
# name never spreads across the codebase.
ANTHROPIC_MODEL=claude-opus-5

# Optional: data-residency hint for the Anthropic API (e.g. "eu").
# Leave empty to use the provider default. See README → Privacy.
ANTHROPIC_INFERENCE_GEO=

# Public site URL, used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Access gate (email + password, single account, no database) ---
# All three must be set for the gate to be active; when any is missing the
# site is public. Generate: NEXTAUTH_SECRET via `openssl rand -base64 32`,
# AUTH_PASSWORD_HASH (base64 of the bcrypt hash — bcrypt's `$` characters
# get mangled by dotenv expansion if stored raw) via
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('your-password', 12)).toString('base64'))"
NEXTAUTH_SECRET=
AUTH_ALLOWED_EMAIL=
AUTH_PASSWORD_HASH=
# Fleet convention: "true" = fail closed (503) when the auth vars above are
# missing or incomplete. Leave empty only for a deliberately public site.
AUTH_REQUIRED=

# Optional: Vercel Edge Config connection string for the fleet killswitch.
# Without it the killswitch fails open (site stays up).
EDGE_CONFIG=
